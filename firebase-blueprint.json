{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Core restaurant profile, tax rules, service charge, and operational settings",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "address": { "type": "string", "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 120 },
        "gstNumber": { "type": "string", "maxLength": 32 },
        "taxRatePercent": { "type": "number" },
        "serviceChargePercent": { "type": "number" },
        "otpExpirySeconds": { "type": "number" },
        "otpResendCooldownSeconds": { "type": "number" },
        "serviceRequestCooldownSeconds": { "type": "number" },
        "currencySymbol": { "type": "string", "maxLength": 8 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "taxRatePercent", "serviceChargePercent", "otpExpirySeconds", "currencySymbol"]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Authenticated staff account and role assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "employeeId": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "mobile": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["owner", "manager", "shift_supervisor", "waiter", "kitchen_supervisor", "kitchen_staff", "cashier"] },
        "section": { "type": "string", "maxLength": 64 },
        "kitchenStationId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "on_leave", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "employeeId", "name", "role", "status"]
    },
    "RestaurantTable": {
      "title": "RestaurantTable",
      "description": "Physical dining table with immutable permanent QR token",
      "type": "object",
      "properties": {
        "tableNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "capacity": { "type": "number" },
        "floor": { "type": "string", "maxLength": 64 },
        "section": { "type": "string", "maxLength": 64 },
        "tableType": { "type": "string", "enum": ["regular", "couple", "family", "outdoor", "vip"] },
        "assignedWaiterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Available", "Reserved", "Verification Pending", "Occupied", "Ordering", "Order Active", "Preparing", "Food Ready", "Bill Requested", "Payment Pending", "Cleaning", "Blocked"] },
        "qrToken": { "type": "string", "minLength": 12, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "qrRevoked": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableNumber", "capacity", "floor", "section", "tableType", "status", "qrToken", "qrRevoked", "isArchived"]
    },
    "TableVerificationRequest": {
      "title": "TableVerificationRequest",
      "description": "Customer QR scan verification request awaiting physical waiter confirmation (never stores OTP)",
      "type": "object",
      "properties": {
        "tableId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tableNumber": { "type": "string", "maxLength": 32 },
        "qrToken": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "presence_confirmed", "verified", "rejected", "expired"] },
        "presenceConfirmed": { "type": "boolean" },
        "otpVerified": { "type": "boolean" },
        "waiterId": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "guestLabel": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableId", "tableNumber", "qrToken", "status", "presenceConfirmed", "otpVerified"]
    },
    "TableSession": {
      "title": "TableSession",
      "description": "Verified active dining session for a table",
      "type": "object",
      "properties": {
        "tableId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tableNumber": { "type": "string", "maxLength": 32 },
        "verificationRequestId": { "type": "string", "maxLength": 128 },
        "waiterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "bill_requested", "payment_pending", "closed"] },
        "guestCount": { "type": "number" },
        "startedAt": { "type": "string", "format": "date-time" },
        "closedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableId", "tableNumber", "status", "guestCount"]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Menu category with sort order and active state",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "icon": { "type": "string", "maxLength": 40 },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "sortOrder", "isActive"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Menu dish with pricing, station assignment, dietary markers, and modifiers",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "categoryId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "price": { "type": "number" },
        "vegType": { "type": "string", "enum": ["veg", "non_veg", "vegan"] },
        "isAvailable": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "prepTimeMinutes": { "type": "number" },
        "stationId": { "type": "string", "maxLength": 64 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "spiceLevel": { "type": "string", "maxLength": 32 }
      },
      "required": ["code", "name", "categoryId", "price", "vegType", "isAvailable", "stationId"]
    },
    "Order": {
      "title": "Order",
      "description": "Central order record unified across dine-in QR, waiter, Swiggy, Zomato, and takeaway",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 32 },
        "channel": { "type": "string", "enum": ["dine_in_qr", "waiter", "swiggy", "zomato", "takeaway", "direct_online"] },
        "tableId": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "externalOrderId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Confirmed", "Preparing", "Partially Ready", "Ready", "Served", "Packed", "Picked Up", "Completed", "Cancelled"] },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "serviceChargeAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "partial", "paid", "refunded"] },
        "priority": { "type": "string", "enum": ["normal", "rush", "vip"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "channel", "status", "subtotal", "totalAmount", "paymentStatus"]
    },
    "KitchenTicket": {
      "title": "KitchenTicket",
      "description": "Station-routed kitchen display ticket linked to a parent order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "stationId": { "type": "string", "maxLength": 64 },
        "stationName": { "type": "string", "maxLength": 64 },
        "channel": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["new", "accepted", "preparing", "ready", "delayed", "served", "packed", "picked_up", "cancelled"] },
        "priority": { "type": "string", "enum": ["normal", "rush", "vip"] },
        "delayReason": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "stationId", "status", "priority"]
    },
    "CustomerServiceRequest": {
      "title": "CustomerServiceRequest",
      "description": "Waiter call or table amenity request from customer",
      "type": "object",
      "properties": {
        "tableId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "maxLength": 128 },
        "requestType": { "type": "string", "enum": ["Call Waiter", "Water", "Extra Plates", "Cutlery", "Napkins", "Sauce", "Bill", "Help", "Other"] },
        "status": { "type": "string", "enum": ["New", "Accepted", "Completed", "Unavailable"] },
        "notes": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableId", "requestType", "status"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Consolidated session bill with immutable settled totals",
      "type": "object",
      "properties": {
        "billNumber": { "type": "string", "maxLength": 32 },
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tableId": { "type": "string", "maxLength": 128 },
        "subtotal": { "type": "number" },
        "taxAmount": { "type": "number" },
        "serviceChargeAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "partial", "paid", "adjusted", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["billNumber", "sessionId", "totalAmount", "paidAmount", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Individual payment transaction toward a bill",
      "type": "object",
      "properties": {
        "billId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["cash", "upi", "card"] },
        "reference": { "type": "string", "maxLength": 80 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["billId", "amount", "method", "recordedBy"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Tracked ingredient stock item with threshold and supplier metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "unit": { "type": "string", "maxLength": 24 },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "supplierName": { "type": "string", "maxLength": 120 },
        "expiryDate": { "type": "string", "maxLength": 32 }
      },
      "required": ["name", "unit", "currentStock", "minStock"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational audit trail entry",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 80 },
        "entityType": { "type": "string", "maxLength": 64 },
        "recordId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorRole", "action", "entityType", "recordId"]
    },
    "RestaurantReview": {
      "title": "RestaurantReview",
      "description": "Post-dining customer rating and feedback",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "overallRating": { "type": "number" },
        "foodRating": { "type": "number" },
        "serviceRating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 600 }
      },
      "required": ["sessionId", "overallRating", "foodRating", "serviceRating"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant operational configuration and public identity"
    },
    "/staff_profiles/{staffId}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "Staff accounts, role assignments, and section bindings"
    },
    "/restaurant_tables/{tableId}": {
      "schema": { "$ref": "#/entities/RestaurantTable" },
      "description": "Dining tables with permanent QR tokens"
    },
    "/table_verification_requests/{requestId}": {
      "schema": { "$ref": "#/entities/TableVerificationRequest" },
      "description": "Waiter presence verification workflow records"
    },
    "/table_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TableSession" },
      "description": "Verified active and closed table sessions"
    },
    "/menu_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/MenuCategory" },
      "description": "Menu categories"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu dishes and availability"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Central unified order records"
    },
    "/kitchen_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/KitchenTicket" },
      "description": "Kitchen station KDS tickets"
    },
    "/customer_service_requests/{requestId}": {
      "schema": { "$ref": "#/entities/CustomerServiceRequest" },
      "description": "Real-time waiter call and table service requests"
    },
    "/bills/{billId}": {
      "schema": { "$ref": "#/entities/Bill" },
      "description": "Consolidated table session bills"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Immutable payment ledger entries"
    },
    "/inventory_items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Ingredient inventory and thresholds"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit log entries"
    },
    "/restaurant_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/RestaurantReview" },
      "description": "Customer post-session reviews"
    }
  }
}
