# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side staff admin bootstrap passcode (leave empty for first-run interactive setup)
ADMIN_PASSCODE=

# Optional delivery platform webhook verification secrets (configure when connecting live partner APIs)
SWIGGY_WEBHOOK_SECRET=
ZOMATO_WEBHOOK_SECRET=
