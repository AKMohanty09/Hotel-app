rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'adyanshacademy@gmail.com';
    }

    function hasStaffProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid));
    }

    function staffRole() {
      return get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data.role;
    }

    function isStaffActive() {
      return hasStaffProfile() && get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data.status == 'active';
    }

    function isAdminOrManager() {
      return isBootstrappedAdmin() || (isStaffActive() && staffRole() in ['owner', 'manager']);
    }

    function isWaiterOrSupervisor() {
      return isAdminOrManager() || (isStaffActive() && staffRole() in ['waiter', 'shift_supervisor', 'cashier']);
    }

    function isKitchenRole() {
      return isAdminOrManager() || (isStaffActive() && staffRole() in ['kitchen_staff', 'kitchen_supervisor']);
    }

    function isAnyStaff() {
      return isBootstrappedAdmin() || isStaffActive();
    }

    // 3. Entity Validation Blueprints
    function isValidRestaurant(data) {
      return data.keys().hasAll(['name', 'taxRatePercent', 'serviceChargePercent', 'otpExpirySeconds', 'currencySymbol']) &&
        data.keys().hasOnly(['name', 'address', 'phone', 'email', 'gstNumber', 'taxRatePercent', 'serviceChargePercent', 'otpExpirySeconds', 'otpResendCooldownSeconds', 'serviceRequestCooldownSeconds', 'currencySymbol', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 50 &&
        data.serviceChargePercent is number && data.serviceChargePercent >= 0 && data.serviceChargePercent <= 30 &&
        data.otpExpirySeconds is number && data.otpExpirySeconds >= 60 && data.otpExpirySeconds <= 900 &&
        data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8;
    }

    function isValidStaffProfile(data) {
      return data.keys().hasAll(['uid', 'employeeId', 'name', 'role', 'status']) &&
        data.keys().hasOnly(['uid', 'employeeId', 'name', 'email', 'mobile', 'role', 'section', 'kitchenStationId', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role in ['owner', 'manager', 'shift_supervisor', 'waiter', 'kitchen_supervisor', 'kitchen_staff', 'cashier'] &&
        data.status in ['active', 'on_leave', 'inactive'];
    }

    function isValidTable(data) {
      return data.keys().hasAll(['tableNumber', 'capacity', 'floor', 'section', 'tableType', 'status', 'qrToken', 'qrRevoked', 'isArchived']) &&
        data.keys().hasOnly(['tableNumber', 'capacity', 'floor', 'section', 'tableType', 'assignedWaiterId', 'status', 'qrToken', 'qrRevoked', 'isArchived', 'notes', 'createdAt', 'updatedAt']) &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 32 &&
        data.capacity is number && data.capacity >= 1 && data.capacity <= 30 &&
        data.floor is string && data.floor.size() >= 1 && data.floor.size() <= 64 &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 64 &&
        data.tableType in ['regular', 'couple', 'family', 'outdoor', 'vip'] &&
        data.status in ['Available', 'Reserved', 'Verification Pending', 'Occupied', 'Ordering', 'Order Active', 'Preparing', 'Food Ready', 'Bill Requested', 'Payment Pending', 'Cleaning', 'Blocked'] &&
        data.qrToken is string && data.qrToken.size() >= 12 && data.qrToken.size() <= 128 && data.qrToken.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.qrRevoked is bool &&
        data.isArchived is bool;
    }

    function isValidVerificationRequest(data) {
      return data.keys().hasAll(['tableId', 'tableNumber', 'qrToken', 'status', 'presenceConfirmed', 'otpVerified']) &&
        data.keys().hasOnly(['tableId', 'tableNumber', 'qrToken', 'status', 'presenceConfirmed', 'otpVerified', 'waiterId', 'sessionId', 'guestLabel', 'createdAt', 'updatedAt']) &&
        isValidId(data.tableId) &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 32 &&
        data.qrToken is string && data.qrToken.size() >= 12 && data.qrToken.size() <= 128 &&
        data.status in ['pending', 'presence_confirmed', 'verified', 'rejected', 'expired'] &&
        data.presenceConfirmed is bool &&
        data.otpVerified is bool;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['tableId', 'tableNumber', 'status', 'guestCount']) &&
        data.keys().hasOnly(['tableId', 'tableNumber', 'verificationRequestId', 'waiterId', 'status', 'guestCount', 'startedAt', 'closedAt']) &&
        isValidId(data.tableId) &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 32 &&
        data.status in ['active', 'bill_requested', 'payment_pending', 'closed'] &&
        data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 30;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'sortOrder', 'isActive']) &&
        data.keys().hasOnly(['name', 'icon', 'sortOrder', 'isActive']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.sortOrder is number &&
        data.isActive is bool;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['code', 'name', 'categoryId', 'price', 'vegType', 'isAvailable', 'stationId']) &&
        data.keys().hasOnly(['code', 'name', 'description', 'categoryId', 'price', 'vegType', 'isAvailable', 'isFeatured', 'prepTimeMinutes', 'stationId', 'photoUrl', 'spiceLevel']) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidId(data.categoryId) &&
        data.price is number && data.price >= 0 &&
        data.vegType in ['veg', 'non_veg', 'vegan'] &&
        data.isAvailable is bool &&
        data.stationId is string && data.stationId.size() >= 1 && data.stationId.size() <= 64;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderNumber', 'channel', 'status', 'subtotal', 'totalAmount', 'paymentStatus']) &&
        data.keys().hasOnly(['orderNumber', 'channel', 'tableId', 'sessionId', 'externalOrderId', 'status', 'subtotal', 'taxAmount', 'serviceChargeAmount', 'discountAmount', 'totalAmount', 'paymentStatus', 'priority', 'createdAt', 'updatedAt']) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32 &&
        data.channel in ['dine_in_qr', 'waiter', 'swiggy', 'zomato', 'takeaway', 'direct_online'] &&
        data.status in ['Draft', 'Submitted', 'Confirmed', 'Preparing', 'Partially Ready', 'Ready', 'Served', 'Packed', 'Picked Up', 'Completed', 'Cancelled'] &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentStatus in ['unpaid', 'partial', 'paid', 'refunded'];
    }

    function isValidKitchenTicket(data) {
      return data.keys().hasAll(['orderId', 'orderNumber', 'stationId', 'status', 'priority']) &&
        data.keys().hasOnly(['orderId', 'orderNumber', 'stationId', 'stationName', 'channel', 'status', 'priority', 'delayReason', 'createdAt', 'updatedAt']) &&
        isValidId(data.orderId) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32 &&
        data.stationId is string && data.stationId.size() >= 1 && data.stationId.size() <= 64 &&
        data.status in ['new', 'accepted', 'preparing', 'ready', 'delayed', 'served', 'packed', 'picked_up', 'cancelled'] &&
        data.priority in ['normal', 'rush', 'vip'];
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['tableId', 'requestType', 'status']) &&
        data.keys().hasOnly(['tableId', 'sessionId', 'requestType', 'status', 'notes', 'createdAt']) &&
        isValidId(data.tableId) &&
        data.requestType in ['Call Waiter', 'Water', 'Extra Plates', 'Cutlery', 'Napkins', 'Sauce', 'Bill', 'Help', 'Other'] &&
        data.status in ['New', 'Accepted', 'Completed', 'Unavailable'];
    }

    function isValidBill(data) {
      return data.keys().hasAll(['billNumber', 'sessionId', 'totalAmount', 'paidAmount', 'status']) &&
        data.keys().hasOnly(['billNumber', 'sessionId', 'tableId', 'subtotal', 'taxAmount', 'serviceChargeAmount', 'discountAmount', 'totalAmount', 'paidAmount', 'status', 'createdAt']) &&
        data.billNumber is string && data.billNumber.size() >= 1 && data.billNumber.size() <= 32 &&
        isValidId(data.sessionId) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.status in ['open', 'partial', 'paid', 'adjusted', 'refunded'];
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['billId', 'amount', 'method', 'recordedBy']) &&
        data.keys().hasOnly(['billId', 'amount', 'method', 'reference', 'recordedBy', 'createdAt']) &&
        isValidId(data.billId) &&
        data.amount is number && data.amount > 0 &&
        data.method in ['cash', 'upi', 'card'] &&
        data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 128;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'unit', 'currentStock', 'minStock']) &&
        data.keys().hasOnly(['name', 'unit', 'currentStock', 'minStock', 'supplierName', 'expiryDate']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24 &&
        data.currentStock is number && data.currentStock >= 0 &&
        data.minStock is number && data.minStock >= 0;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'actorRole', 'action', 'entityType', 'recordId']) &&
        data.keys().hasOnly(['actorId', 'actorRole', 'action', 'entityType', 'recordId', 'reason', 'createdAt']) &&
        data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
        data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 40 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 64 &&
        data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 128;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['sessionId', 'overallRating', 'foodRating', 'serviceRating']) &&
        data.keys().hasOnly(['sessionId', 'overallRating', 'foodRating', 'serviceRating', 'comment']) &&
        isValidId(data.sessionId) &&
        data.overallRating is number && data.overallRating >= 1 && data.overallRating <= 5 &&
        data.foodRating is number && data.foodRating >= 1 && data.foodRating <= 5 &&
        data.serviceRating is number && data.serviceRating >= 1 && data.serviceRating <= 5;
    }

    // Connection ping check
    match /test/connection {
      allow get: if request.time != null;
    }

    // 4. Collection Rules

    // Public restaurant configuration (non-sensitive operational info)
    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId);
      allow list: if isAnyStaff();
      allow create: if isValidId(restaurantId) && isAdminOrManager() && isValidRestaurant(incoming());
      allow update: if isValidId(restaurantId) && isAdminOrManager() && isValidRestaurant(incoming());
      allow delete: if false;
    }

    // Staff Profiles (PII isolated; role mutation locked to Admin/Manager)
    match /staff_profiles/{staffId} {
      allow get: if isValidId(staffId) && isSignedIn() && (request.auth.uid == staffId || isAdminOrManager());
      allow list: if isAdminOrManager();
      allow create: if isValidId(staffId) && isAdminOrManager() && isValidStaffProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(staffId) && isValidStaffProfile(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdminOrManager() ||
        (request.auth.uid == staffId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mobile', 'updatedAt']))
      );
      allow delete: if isValidId(staffId) && isAdminOrManager();
    }

    // Restaurant Tables (Permanent QR protected)
    match /restaurant_tables/{tableId} {
      allow get: if isValidId(tableId);
      allow list: if existing().isArchived == false || isAdminOrManager();
      allow create: if isValidId(tableId) && isAdminOrManager() && isValidTable(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(tableId) && isValidTable(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        (isAdminOrManager() && (incoming().qrToken == existing().qrToken || incoming().qrRevoked == true)) ||
        (isWaiterOrSupervisor() && incoming().qrToken == existing().qrToken && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isValidId(tableId) && isAdminOrManager();
    }

    // Table Verification Requests (Waiter physical confirmation required before OTP verify)
    match /table_verification_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if isWaiterOrSupervisor();
      allow create: if isValidId(requestId) && isValidVerificationRequest(incoming()) &&
        exists(/databases/$(database)/documents/restaurant_tables/$(incoming().tableId)) &&
        incoming().status == 'pending' &&
        incoming().presenceConfirmed == false &&
        incoming().otpVerified == false &&
        incoming().createdAt == request.time;
      allow update: if isValidId(requestId) && isValidVerificationRequest(incoming()) &&
        incoming().tableId == existing().tableId &&
        incoming().qrToken == existing().qrToken &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isWaiterOrSupervisor() && incoming().diff(existing()).affectedKeys().hasOnly(['presenceConfirmed', 'status', 'waiterId', 'updatedAt'])) ||
          (existing().presenceConfirmed == true && incoming().status == 'verified' && incoming().otpVerified == true && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'otpVerified', 'sessionId', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Active Table Sessions
    match /table_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if isWaiterOrSupervisor();
      allow create: if isValidId(sessionId) && isValidSession(incoming()) &&
        exists(/databases/$(database)/documents/restaurant_tables/$(incoming().tableId)) &&
        incoming().startedAt == request.time && (
          isWaiterOrSupervisor() ||
          (incoming().verificationRequestId is string &&
           get(/databases/$(database)/documents/table_verification_requests/$(incoming().verificationRequestId)).data.presenceConfirmed == true &&
           get(/databases/$(database)/documents/table_verification_requests/$(incoming().verificationRequestId)).data.tableId == incoming().tableId)
        );
      allow update: if isValidId(sessionId) && isValidSession(incoming()) && existing().status != 'closed' &&
        incoming().tableId == existing().tableId && (
          isWaiterOrSupervisor() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      allow delete: if false;
    }

    // Menu Categories & Items (Public read, Manager/Admin write)
    match /menu_categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if existing().isActive == true || isAdminOrManager();
      allow create, update: if isValidId(categoryId) && isAdminOrManager() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdminOrManager();
    }

    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if existing().price >= 0;
      allow create, update: if isValidId(itemId) && isAdminOrManager() && isValidMenuItem(incoming());
      allow delete: if isValidId(itemId) && isAdminOrManager();
    }

    // Central Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAnyStaff() || (existing().sessionId is string && exists(/databases/$(database)/documents/table_sessions/$(existing().sessionId))));
      allow list: if isAnyStaff();
      allow create: if isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().createdAt == request.time && (
          isWaiterOrSupervisor() ||
          (incoming().channel == 'dine_in_qr' &&
           incoming().sessionId is string &&
           get(/databases/$(database)/documents/table_sessions/$(incoming().sessionId)).data.status == 'active' &&
           get(/databases/$(database)/documents/table_sessions/$(incoming().sessionId)).data.tableId == incoming().tableId)
        );
      allow update: if isValidId(orderId) && isValidOrder(incoming()) && existing().status != 'Completed' && existing().status != 'Cancelled' &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdminOrManager() ||
          (isWaiterOrSupervisor() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])) ||
          (isKitchenRole() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Kitchen Tickets (Isolated to staff; Kitchen cannot access bills/payments/settings)
    match /kitchen_tickets/{ticketId} {
      allow get, list: if isAnyStaff();
      allow create: if isValidId(ticketId) && isValidKitchenTicket(incoming()) &&
        exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
        incoming().createdAt == request.time && (
          isWaiterOrSupervisor() ||
          get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.channel == 'dine_in_qr'
        );
      allow update: if isValidId(ticketId) && isValidKitchenTicket(incoming()) &&
        incoming().orderId == existing().orderId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdminOrManager() ||
          (isKitchenRole() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'delayReason', 'updatedAt'])) ||
          (isWaiterOrSupervisor() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Customer Service Requests
    match /customer_service_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if isWaiterOrSupervisor();
      allow create: if isValidId(requestId) && isValidServiceRequest(incoming()) &&
        exists(/databases/$(database)/documents/restaurant_tables/$(incoming().tableId)) &&
        incoming().status == 'New' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(requestId) && isValidServiceRequest(incoming()) && isWaiterOrSupervisor() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes']);
      allow delete: if false;
    }

    // Bills (Kitchen strictly denied; paid bills immutable except audited manager adjustment)
    match /bills/{billId} {
      allow get: if isValidId(billId) && (isWaiterOrSupervisor() || (existing().sessionId is string && exists(/databases/$(database)/documents/table_sessions/$(existing().sessionId))));
      allow list: if isWaiterOrSupervisor();
      allow create: if isValidId(billId) && isWaiterOrSupervisor() && isValidBill(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(billId) && isValidBill(incoming()) && incoming().createdAt == existing().createdAt && (
        (isAdminOrManager() && (existing().status != 'paid' || incoming().status in ['adjusted', 'refunded'])) ||
        (isWaiterOrSupervisor() && existing().status != 'paid' && incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'status']))
      );
      allow delete: if false;
    }

    // Payments (Immutable ledger; Kitchen strictly denied)
    match /payments/{paymentId} {
      allow get, list: if isWaiterOrSupervisor();
      allow create: if isValidId(paymentId) && isWaiterOrSupervisor() && isValidPayment(incoming()) &&
        exists(/databases/$(database)/documents/bills/$(incoming().billId)) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Inventory (Manager/Admin + Kitchen read)
    match /inventory_items/{itemId} {
      allow get, list: if isAnyStaff();
      allow create, update: if isValidId(itemId) && isAdminOrManager() && isValidInventoryItem(incoming());
      allow delete: if isValidId(itemId) && isAdminOrManager();
    }

    // Audit Logs (Append-only, Manager/Admin read)
    match /audit_logs/{logId} {
      allow get, list: if isAdminOrManager();
      allow create: if isValidId(logId) && isAnyStaff() && isValidAuditLog(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Customer Reviews (Closed session required)
    match /restaurant_reviews/{reviewId} {
      allow get, list: if isAdminOrManager();
      allow create: if isValidId(reviewId) && isValidReview(incoming()) &&
        get(/databases/$(database)/documents/table_sessions/$(incoming().sessionId)).data.status == 'closed';
      allow update, delete: if false;
    }
  }
}
